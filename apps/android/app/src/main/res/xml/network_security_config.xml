<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS / WSS only. The debug build type overrides this file to allow
     cleartext for local development (src/debug/res/xml/network_security_config.xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
