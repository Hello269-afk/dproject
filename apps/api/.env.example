# --- Required in production ---
NODE_ENV=development
JWT_SECRET=change-me-to-64-random-chars          # openssl rand -base64 48
PAIRING_PEPPER=change-me-to-32-random-chars       # openssl rand -base64 24

# --- URLs phones and browsers use to reach you (default: http://<LAN IP>:4000) ---
# PUBLIC_API_URL=https://mdm.example.com
# PUBLIC_WEB_URL=https://mdm.example.com
CORS_ORIGINS=http://localhost:5173
PORT=4000

# --- Database: postgres:// URL, or leave empty to use embedded PGlite in PGLITE_DIR ---
# DATABASE_URL=postgres://mdm:secret@localhost:5432/mdm
PGLITE_DIR=./data/pglite

# --- Enrollment landing page "Install the app" link (e.g. GitHub release APK) ---
# APP_DOWNLOAD_URL=https://github.com/<org>/<repo>/releases/download/latest/mdm-agent.apk
# Company-owned (factory reset + QR) setup also needs the APK signing certificate checksum:
#   apps/android/scripts/signature-checksum.sh   → paste the output here
# APP_SIGNATURE_CHECKSUM=

# --- WebRTC. STUN works on most networks; TURN is needed behind symmetric NAT / mobile carriers ---
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SHARED_SECRET=coturn-static-auth-secret     # preferred: short-lived credentials
# TURN_USERNAME= / TURN_CREDENTIAL=                # or static credentials
SCREEN_SESSION_MAX_MINUTES=30
